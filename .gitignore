# Root .gitignore for NOTEShub monorepo

# Miscellaneous
*.log
*.tmp
.DS_Store
Thumbs.db

# Sensitive credentials & keys (NEVER COMMIT)
*.keystore
*.jks
**/key.properties
.env
.env*.local
*service-account*.json
*serviceAccount*.json

# Mobile (Flutter) build outputs & caches
mobile/build/
**/build/
.gradle/
**/android/.gradle/
mobile/release/
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/

# Web (Next.js) build outputs & dependencies
project/node_modules/
project/.next/
project/out/
project/.vercel/
